---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getAllPosts, slugify } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const tags = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.set(slugify(t), t)));
  return [...tags].map(([slug, name]) => ({
    params: { tag: slug },
    props: { name, posts: posts.filter((p) => p.data.tags.includes(name)) },
  }));
}
const { name, posts } = Astro.props;
---

<Base title={`Tag: ${name}`}>
  <div class="shell">
    <header class="page-head"><h1>Tag: {name}</h1><p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p></header>
    <PostList posts={posts} />
  </div>
</Base>
