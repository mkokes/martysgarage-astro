---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Ask a question or request service from Marty's Garage">
  <article class="panel">
    <h1>Contact</h1>
    <p>If you'd like to ask me a question or if you have a machine in need of service fill out the form below and I'll get back to you.</p>
    <p>
      Follow along:
      <a href="https://facebook.com/martysgarage">Facebook</a> &middot;
      <a href="https://twitter.com/martysgarage">Twitter</a> &middot;
      <a href="/rss.xml">RSS</a>
    </p>
    <form class="contact" action="https://formspree.io/f/xdeekojw" method="POST">
      <label>Name <input type="text" name="name" required autocomplete="name" /></label>
      <label>Email <input type="email" name="email" required autocomplete="email" /></label>
      <label>Message <textarea name="message" rows="7" required></textarea></label>
      <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit">Send</button>
    </form>
  </article>
</Base>
