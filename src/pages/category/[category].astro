---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getAllPosts, slugify } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categories = new Map<string, string>();
  posts.forEach((p) => p.data.categories.forEach((t) => categories.set(slugify(t), t)));
  return [...categories].map(([slug, name]) => ({
    params: { category: slug },
    props: { name, posts: posts.filter((p) => p.data.categories.includes(name)) },
  }));
}
const { name, posts } = Astro.props;
---

<Base title={`Category: ${name}`}>
  <div class="shell">
    <header class="page-head"><h1>Category: {name}</h1><p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p></header>
    <PostList posts={posts} />
  </div>
</Base>
