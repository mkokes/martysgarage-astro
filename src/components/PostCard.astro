---
import { postPath, formatDate, type Post } from '../lib/site';
const { post } = Astro.props as { post: Post };
const href = postPath(post);
---

<article class:list={['post-card panel', { 'no-image': !post.data.image }]}>
  {post.data.image && (
    <a href={href} tabindex="-1" aria-hidden="true"><img src={post.data.image} alt="" loading="lazy" decoding="async" /></a>
  )}
  <div>
    <h2><a href={href}>{post.data.title}</a></h2>
    <div class="meta">{formatDate(post.data.date)}</div>
    <p>{post.data.excerpt} <a href={href}>Read More…</a></p>
  </div>
</article>
