---
import { postPath, postImage, formatDate, type Post } from '../lib/site';
const { post, compact = false } = Astro.props as { post: Post; compact?: boolean };
const href = postPath(post);
const image = postImage(post);
const category = post.data.categories[0];
const Heading = compact ? 'h3' : 'h2';
---

<article class="card">
  <div class="card-media">
    {image
      ? <img src={image} alt="" loading="lazy" decoding="async" />
      : <span class="fallback-art" aria-hidden="true">MG</span>}
  </div>
  <div class="card-body">
    {category && !compact && <span class="pill">{category}</span>}
    <Heading class="card-title"><a href={href}>{post.data.title}</a></Heading>
    <div class="meta">{formatDate(post.data.date)}</div>
    {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
  </div>
</article>
