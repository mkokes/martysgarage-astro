---
import { postPath, formatDate, type Post } from '../lib/site';
const { post } = Astro.props as { post: Post };
const href = postPath(post);
---

<article class="featured">
  <a class="featured-media" href={href} tabindex="-1" aria-hidden="true">
    {post.data.image
      ? <img src={post.data.image} alt="" fetchpriority="high" decoding="async" />
      : <span class="fallback-art">MG</span>}
  </a>
  <div class="featured-body">
    <span class="eyebrow">Latest from the garage</span>
    <h2><a href={href}>{post.data.title}</a></h2>
    <div class="meta">{formatDate(post.data.date)}</div>
    {post.data.excerpt && <p>{post.data.excerpt}</p>}
    <a class="button" href={href}>Read more</a>
  </div>
</article>
